      <aliases enabled='yes' />
      <column caption='Updated sales' datatype='real' name='[Calculation_0597912555495424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Quantity]*[Unit Price]' />
      </column>
      <column caption='Updated sales 2' datatype='real' name='[Calculation_0597912555876353]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Sales],0&#13;&#10;)' />
      </column>
      <column caption='Ifnull_Segment' datatype='string' name='[Calculation_0597912557879298]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([Segment],&apos;CS&apos;)' />
      </column>
      <column caption='Profit %' datatype='real' name='[Calculation_0597912559017987]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Profit]/[Sales]' />
      </column>
      <column caption='Discount %' datatype='real' name='[Calculation_0597912559263748]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Discount]/[Sales]' />
      </column>
      <column caption='Previous sales' datatype='real' name='[Calculation_0597912559808518]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Sales]-100' />
      </column>
      <column caption='sales Growth' datatype='real' name='[Calculation_0597912559910919]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Sales]-[Calculation_0597912559808518])/[Calculation_0597912559808518]' />
      </column>
      <column caption='If condition' datatype='string' name='[Calculation_0597912560230408]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Sales]&gt;10000 THEN &quot;High&quot; ELSE&quot;Low&quot; END' />
      </column>
      <column caption='Case segment' datatype='string' name='[Calculation_0597912561315849]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Segment]&#13;&#10;WHEN &quot;Consumer&quot; THEN &quot;C&quot;&#13;&#10;WHEN  &quot;Corporate&quot; THEN &quot;B&quot;&#13;&#10;ELSE &quot;other&quot;END' />
      </column>
      <column caption='W/M/K' datatype='string' name='[Calculation_0597912562118667]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Sub-Category]&#13;&#10;when &quot;Women&quot; then &quot;W&quot;&#13;&#10;when  &quot;Men&quot; Then &quot;M&quot;&#13;&#10;when &quot;Kids&quot; then &quot;k&quot;&#13;&#10;else &quot;Other&quot; end' />
      </column>
      <column caption='diff order/ship' datatype='integer' name='[Calculation_0597912562651148]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[Order Date],[Ship Date])' />
      </column>
      <column caption='month ' datatype='string' name='[Calculation_0597912563253261]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;,[Order Date])' />
      </column>
      <column caption='Year' datatype='integer' name='[Calculation_0597912563773454]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR([Order Date])' />
      </column>
      <column caption='Quarter' datatype='string' name='[Calculation_0597912564211727]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;quarter&apos;,[Order Date])' />
      </column>
      <column caption='Running Total' datatype='real' name='[Calculation_0597912564535312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Moving Average' datatype='real' name='[Calculation_0646566343139328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(SUM([Sales]),-2,0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% of total' datatype='real' name='[Calculation_0646566344138753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales])/TOTAL(SUM([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top values' datatype='boolean' name='[Calculation_0646566359609350]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SUM([Profit])&gt;=[Parameters].[Parameter 0646566359142405]' />
      </column>
      <column caption='Region selector' datatype='boolean' name='[Calculation_0646566648152074]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Region]=[Parameters].[Parameter 0646566647902217]' />
      </column>
      <column caption='Top 10 selector' datatype='boolean' name='[Calculation_0646566649028621]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK(SUM([Sales]))&gt;=[Parameters].[Parameter 0646566648668172]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='real' hidden='true' name='[Profit Margin %]' role='measure' type='quantitative' />
      <column caption='Ship Mode - Split 1' datatype='string' name='[Ship Mode - Split 1]' role='dimension' type='nominal' user:SplitFieldIndex='1' user:SplitFieldOrigin='[federated.04xz6v90fmnml71csufd20tcch1n].[Ship Mode]'>
